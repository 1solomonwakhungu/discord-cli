{
  "name": "discord-cli",
  "version": "1.8.0",
  "description": "Command-line tool for managing Discord servers via AI agents",
  "output_format": "json",
  "global_options": [
    {
      "name": "--token",
      "type": "string",
      "description": "Discord bot token. Overrides DISCORD_BOT_TOKEN and .env."
    },
    {
      "name": "--guild",
      "type": "resource",
      "description": "Target guild ID or config alias. Required when the bot is in more than one guild."
    },
    {
      "name": "--profile",
      "type": "string",
      "description": "Configuration profile name from config.toml."
    },
    {
      "name": "--human",
      "type": "flag",
      "description": "Render human-readable tables instead of the default JSON output."
    },
    {
      "name": "--gateway",
      "type": "flag",
      "description": "Use a WebSocket Gateway connection instead of the faster REST-first default."
    },
    {
      "name": "--no-plugins",
      "type": "flag",
      "description": "Disable loading third-party discord_cli.plugins entry points."
    },
    {
      "name": "--compact",
      "type": "flag",
      "description": "Emit minified single-line JSON without whitespace."
    },
    {
      "name": "--fields",
      "type": "string",
      "description": "Comma-separated dot-paths to project from output data (e.g. id,name,author.name)."
    },
    {
      "name": "--max-chars",
      "type": "int",
      "description": "Truncate JSON output cleanly within N characters (min 256) while staying valid JSON."
    },
    {
      "name": "--string-ids",
      "type": "flag",
      "description": "Serialize Discord 64-bit snowflake IDs as strings for JS/TS safety."
    },
    {
      "name": "--format",
      "type": "string",
      "choices": [
        "json",
        "jsonl",
        "csv",
        "table",
        "markdown",
        "raw"
      ],
      "description": "Output format: json, jsonl, csv, table, markdown, or raw."
    },
    {
      "name": "--quiet",
      "type": "flag",
      "description": "Print only primary resource IDs (one per line)."
    },
    {
      "name": "--output",
      "type": "string",
      "description": "Write formatted output atomically to a file path."
    },
    {
      "name": "--policy",
      "type": "string",
      "choices": [
        "read-only",
        "allow-write",
        "allow-destructive"
      ],
      "description": "Safety policy ceiling: read-only, allow-write, or allow-destructive."
    },
    {
      "name": "--dry-run",
      "type": "flag",
      "description": "Preview a mutating command and return a confirm_token without modifying Discord."
    },
    {
      "name": "--yes",
      "type": "flag",
      "description": "Confirm a destructive command when DISCORD_CLI_REQUIRE_CONFIRM=1 is active."
    },
    {
      "name": "--confirm-token",
      "type": "string",
      "description": "Confirmation token obtained from --dry-run for destructive commands."
    },
    {
      "name": "--max-mutations",
      "type": "int",
      "description": "Maximum bulk mutations allowed (e.g. for message purge)."
    },
    {
      "name": "--reason",
      "type": "string",
      "description": "Default Discord audit log reason for mutating commands."
    },
    {
      "name": "--untrusted-envelope",
      "type": "flag",
      "description": "Wrap untrusted Discord text fields in a random-nonce XML boundary for prompt-injection defense."
    },
    {
      "name": "--redact-pii",
      "type": "flag",
      "description": "Redact emails, tokens, API keys, JWTs, and webhook secrets from output."
    },
    {
      "name": "--semantic-exit-codes",
      "type": "flag",
      "description": "Return semantic exit codes (3=auth, 4=not found, 5=permission, 6=policy, 7=rate limit)."
    }
  ],
  "command_groups": [
    {
      "name": "api",
      "description": "Call any Discord REST API v10 endpoint directly with auth and rate-limit handling.",
      "commands": [
        {
          "name": "request",
          "description": "Execute a raw authenticated Discord REST API v10 request.",
          "args": [
            {
              "name": "method",
              "required": true
            },
            {
              "name": "endpoint",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--json-body"
            },
            {
              "name": "--query"
            },
            {
              "name": "--reason"
            }
          ]
        }
      ]
    },
