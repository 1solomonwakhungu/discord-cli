{
  "name": "discord-cli",
  "version": "1.8.0",
  "description": "Command-line tool for managing Discord servers via AI agents",
  "output_format": "json",
  "global_options": [
    {"name": "--token", "type": "string", "description": "Discord bot token (overrides env/.env)"},
    {"name": "--guild", "type": "int", "description": "Target guild ID (for multi-guild bots)"},
    {"name": "--human", "type": "flag", "description": "Human-readable table output (default: JSON)"},
    {"name": "--gateway", "type": "flag", "description": "Use WebSocket Gateway instead of REST-first default"},
    {"name": "--no-plugins", "type": "flag", "description": "Disable loading third-party discord_cli.plugins entry points"},
    {"name": "--compact", "type": "flag", "description": "Emit minified single-line JSON without whitespace"},
    {"name": "--fields", "type": "string", "description": "Comma-separated dot-paths to project from output data"},
    {"name": "--max-chars", "type": "int", "description": "Truncate JSON output cleanly within N characters while staying valid JSON"},
    {"name": "--string-ids", "type": "flag", "description": "Serialize 64-bit snowflake IDs as strings for JS/TS safety"},
    {"name": "--format", "type": "string", "choices": ["json", "jsonl", "csv", "table", "markdown", "raw"], "description": "Output format"},
    {"name": "--quiet", "type": "flag", "description": "Print only primary resource IDs (one per line)"},
    {"name": "--output", "type": "string", "description": "Write formatted output atomically to a file path"}
  ],
  "command_groups": [
    {
      "name": "channel",
      "description": "Manage guild channels",
      "commands": [
        {"name": "list", "description": "List all channels", "args": [], "options": []},
        {"name": "create", "description": "Create a new channel", "args": [{"name": "name", "required": true}], "options": [{"name": "--type", "default": "text", "choices": ["text", "voice", "stage", "forum"]}, {"name": "--category", "type": "int"}, {"name": "--topic", "type": "string"}, {"name": "--position", "type": "int"}, {"name": "--nsfw", "type": "flag"}, {"name": "--slowmode", "type": "int"}]},
        {"name": "delete", "description": "Delete a channel", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": []},
        {"name": "edit", "description": "Edit a channel", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--name"}, {"name": "--topic"}, {"name": "--position", "type": "int"}, {"name": "--slowmode", "type": "int"}, {"name": "--nsfw", "type": "tri_state_bool"}]},
        {"name": "move", "description": "Move channel to category", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--category", "type": "int", "required": true}]},
        {"name": "info", "description": "Detailed channel info", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": []}
      ]
    },
    {
      "name": "category",
      "description": "Manage channel categories",
      "commands": [
        {"name": "list", "description": "List all categories", "args": [], "options": []},
        {"name": "create", "description": "Create a category", "args": [{"name": "name", "required": true}], "options": [{"name": "--position", "type": "int"}]},
        {"name": "delete", "description": "Delete a category", "args": [{"name": "category_id", "type": "int", "required": true}], "options": []},
        {"name": "edit", "description": "Edit a category", "args": [{"name": "category_id", "type": "int", "required": true}], "options": [{"name": "--name"}, {"name": "--position", "type": "int"}]}
      ]
    },
    {
      "name": "role",
      "description": "Manage server roles",
      "commands": [
        {"name": "list", "description": "List all roles", "args": [], "options": []},
        {"name": "create", "description": "Create a role", "args": [{"name": "name", "required": true}], "options": [{"name": "--color"}, {"name": "--permissions"}, {"name": "--mentionable", "type": "flag"}, {"name": "--hoist", "type": "flag"}]},
        {"name": "delete", "description": "Delete a role", "args": [{"name": "role_id", "type": "int", "required": true}], "options": []},
        {"name": "edit", "description": "Edit a role", "args": [{"name": "role_id", "type": "int", "required": true}], "options": [{"name": "--name"}, {"name": "--color"}, {"name": "--permissions"}, {"name": "--mentionable", "type": "tri_state_bool"}, {"name": "--hoist", "type": "tri_state_bool"}]},
        {"name": "assign", "description": "Assign role to user", "args": [{"name": "role_id", "type": "int", "required": true}, {"name": "user_id", "type": "int", "required": true}], "options": []},
        {"name": "remove", "description": "Remove role from user", "args": [{"name": "role_id", "type": "int", "required": true}, {"name": "user_id", "type": "int", "required": true}], "options": []},
        {"name": "info", "description": "Detailed role info", "args": [{"name": "role_id", "type": "int", "required": true}], "options": []}
      ]
    },
    {
      "name": "member",
      "description": "Moderate and manage members",
      "commands": [
        {"name": "list", "description": "List all members", "args": [], "options": [{"name": "--limit", "type": "int"}, {"name": "--after", "type": "int"}]},
        {"name": "info", "description": "Detailed member info", "args": [{"name": "member_id", "type": "int", "required": true}], "options": []},
        {"name": "kick", "description": "Kick a member", "args": [{"name": "member_id", "type": "int", "required": true}], "options": [{"name": "--reason"}]},
        {"name": "ban", "description": "Ban a member", "args": [{"name": "member_id", "type": "int", "required": true}], "options": [{"name": "--reason"}, {"name": "--delete-message-days", "type": "int", "default": 0}]},
        {"name": "unban", "description": "Unban a user", "args": [{"name": "user_id", "type": "int", "required": true}], "options": []},
        {"name": "timeout", "description": "Timeout a member", "args": [{"name": "member_id", "type": "int", "required": true}, {"name": "duration", "required": true}], "options": [{"name": "--reason"}]},
        {"name": "untimeout", "description": "Remove timeout", "args": [{"name": "member_id", "type": "int", "required": true}], "options": []},
        {"name": "nickname", "description": "Set nickname", "args": [{"name": "member_id", "type": "int", "required": true}, {"name": "nickname", "required": true}], "options": []},
        {"name": "roles", "description": "List roles for a member", "args": [{"name": "member_id", "type": "int", "required": true}], "options": []}
      ]
    },
    {
      "name": "message",
      "description": "Manage channel messages",
      "commands": [
        {"name": "list", "description": "List recent messages in a channel", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--limit", "type": "int", "default": 20}, {"name": "--before", "type": "int"}, {"name": "--after", "type": "int"}]},
        {"name": "send", "description": "Send a message", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--content"}, {"name": "--embed-json"}, {"name": "--embed-file"}, {"name": "--file"}, {"name": "--reply-to", "type": "int"}, {"name": "--silent", "type": "flag"}, {"name": "--split", "type": "flag"}]},
        {"name": "edit", "description": "Edit a message", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--content", "required": true}]},
        {"name": "delete", "description": "Delete a message", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}]},
        {"name": "purge", "description": "Bulk delete messages", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--limit", "type": "int", "required": true}, {"name": "--user", "type": "int"}, {"name": "--contains"}]},
        {"name": "fetch", "description": "Get message content", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}]},
        {"name": "pin", "description": "Pin a message", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}]},
        {"name": "unpin", "description": "Unpin a message", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}]},
        {"name": "pins", "description": "List pinned messages", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--limit", "type": "int", "default": 50}]},
        {"name": "publish", "description": "Crosspost announcement message", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}]},
        {"name": "download", "description": "Download message attachments", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--out", "required": true}]},
        {"name": "react", "description": "React to a message", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--emoji", "required": true}]},
        {"name": "unreact", "description": "Remove a reaction", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--emoji", "required": true}, {"name": "--user", "type": "int"}]}
      ]
    },
    {
      "name": "guild",
      "description": "Server-level management",
      "commands": [
        {"name": "info", "description": "Server info", "args": [], "options": []},
        {"name": "edit", "description": "Edit server", "args": [], "options": [{"name": "--name"}, {"name": "--description"}]},
        {
          "name": "emojis",
          "description": "Manage custom emojis",
          "subcommands": [
            {"name": "list", "description": "List custom emojis", "args": [], "options": []},
            {"name": "create", "description": "Create a custom emoji", "args": [{"name": "name", "required": true}], "options": [{"name": "--image", "required": true}]},
            {"name": "delete", "description": "Delete a custom emoji", "args": [{"name": "emoji_id", "type": "int", "required": true}], "options": []}
          ]
        },
        {
          "name": "stickers",
          "description": "Manage custom stickers",
          "subcommands": [
            {"name": "list", "description": "List custom stickers", "args": [], "options": []}
          ]
        },
        {
          "name": "bans",
          "description": "Inspect guild bans",
          "subcommands": [
            {"name": "list", "description": "List banned users", "args": [], "options": []}
          ]
        },
        {"name": "regions", "description": "Available voice regions", "args": [], "options": []},
        {"name": "prune", "description": "Prune inactive members", "args": [], "options": [{"name": "--days", "type": "int", "required": true}, {"name": "--dry-run", "default": "true"}]}
      ]
    },
    {
      "name": "permissions",
      "description": "Fine-grained permission control",
      "commands": [
        {"name": "list", "description": "List permission overwrites", "args": [], "options": [{"name": "--channel", "type": "int", "required": true}]},
        {"name": "set", "description": "Set permissions", "args": [], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--role", "type": "int"}, {"name": "--user", "type": "int"}, {"name": "--allow"}, {"name": "--deny"}]},
        {"name": "reset", "description": "Reset permissions", "args": [], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--role", "type": "int"}, {"name": "--user", "type": "int"}]}
      ]
    },
    {
      "name": "webhook",
      "description": "Manage webhooks",
      "commands": [
        {"name": "list", "description": "List webhooks", "args": [], "options": [{"name": "--channel", "type": "int"}, {"name": "--show-secrets", "type": "flag"}]},
        {"name": "create", "description": "Create webhook", "args": [], "options": [{"name": "--channel", "type": "int", "required": true}, {"name": "--name", "required": true}, {"name": "--show-secrets", "type": "flag"}]},
        {"name": "edit", "description": "Edit webhook", "args": [{"name": "webhook_id", "type": "int", "required": true}], "options": [{"name": "--name"}, {"name": "--channel", "type": "int"}, {"name": "--show-secrets", "type": "flag"}]},
        {"name": "delete", "description": "Delete webhook", "args": [{"name": "webhook_id", "type": "int", "required": true}], "options": []},
        {"name": "info", "description": "Webhook details", "args": [{"name": "webhook_id", "type": "int", "required": true}], "options": [{"name": "--show-secrets", "type": "flag"}]},
        {"name": "send", "description": "Send message via webhook URL (zero Gateway)", "args": [], "options": [{"name": "--url"}, {"name": "--content"}, {"name": "--embed-json"}, {"name": "--embed-file"}, {"name": "--file"}, {"name": "--username"}, {"name": "--avatar-url"}, {"name": "--thread-id", "type": "int"}, {"name": "--thread-name"}, {"name": "--template", "choices": ["alert", "deploy", "error", "info", "success", "warning"]}, {"name": "--title"}, {"name": "--description"}, {"name": "--color"}, {"name": "--field"}, {"name": "--split", "type": "flag"}, {"name": "--silent", "type": "flag"}, {"name": "--no-wait", "type": "flag"}]},
        {"name": "edit-message", "description": "Edit webhook message (zero Gateway)", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--url"}, {"name": "--thread-id", "type": "int"}, {"name": "--content"}, {"name": "--embed-json"}, {"name": "--embed-file"}, {"name": "--template", "choices": ["alert", "deploy", "error", "info", "success", "warning"]}, {"name": "--title"}, {"name": "--description"}, {"name": "--color"}, {"name": "--field"}]},
        {"name": "delete-message", "description": "Delete webhook message (zero Gateway)", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--url"}, {"name": "--thread-id", "type": "int"}]},
        {"name": "fetch-message", "description": "Fetch webhook message (zero Gateway)", "args": [{"name": "message_id", "type": "int", "required": true}], "options": [{"name": "--url"}, {"name": "--thread-id", "type": "int"}]}
      ]
    },
    {
      "name": "invites",
      "description": "Manage server invites",
      "commands": [
        {"name": "list", "description": "List all invites", "args": [], "options": []},
        {"name": "create", "description": "Create invite", "args": [], "options": [{"name": "--channel-id", "type": "int", "required": true}, {"name": "--max-age", "type": "int", "default": 0}, {"name": "--max-uses", "type": "int", "default": 0}, {"name": "--temporary", "type": "flag"}]},
        {"name": "delete", "description": "Delete invite", "args": [{"name": "code", "required": true}], "options": []}
      ]
    },
    {
      "name": "threads",
      "description": "Manage forum and thread channels",
      "commands": [
        {"name": "list", "description": "List threads", "args": [], "options": [{"name": "--channel-id", "type": "int"}]},
        {"name": "create", "description": "Create thread", "args": [{"name": "name", "required": true}], "options": [{"name": "--channel-id", "type": "int", "required": true}, {"name": "--type", "default": "public", "choices": ["public", "private"]}, {"name": "--auto-archive", "default": "1440", "choices": ["60", "1440", "4320", "10080"]}]},
        {"name": "delete", "description": "Delete thread", "args": [{"name": "thread_id", "type": "int", "required": true}], "options": []},
        {"name": "archive", "description": "Archive thread", "args": [{"name": "thread_id", "type": "int", "required": true}], "options": []},
        {"name": "unarchive", "description": "Unarchive thread", "args": [{"name": "thread_id", "type": "int", "required": true}], "options": []},
        {"name": "members", "description": "List thread members", "args": [{"name": "thread_id", "type": "int", "required": true}], "options": []}
      ]
    },
    {
      "name": "search",
      "description": "Search server content",
      "commands": [
        {"name": "messages", "description": "Search messages", "args": [{"name": "query", "required": true}], "options": [{"name": "--channel-id", "type": "int"}, {"name": "--limit", "type": "int", "default": 25}, {"name": "--scan-limit", "type": "int", "default": 500}]},
        {"name": "members", "description": "Search members", "args": [{"name": "query", "required": true}], "options": [{"name": "--limit", "type": "int", "default": 25}]}
      ]
    },
    {
      "name": "export",
      "description": "Export message history",
      "commands": [
        {"name": "channel", "description": "Export messages from a channel", "args": [{"name": "channel_id", "type": "int", "required": true}], "options": [{"name": "--limit", "type": "int", "default": 100}, {"name": "--format", "default": "json", "choices": ["json", "csv"]}]}
      ]
    },
    {
      "name": "plugins",
      "description": "Inspect third-party plugins discovered via the discord_cli.plugins entry-point group",
      "commands": [
        {"name": "list", "description": "List loaded plugins", "args": [], "options": []}
      ]
    },
    {
      "name": "audit",
      "description": "Inspect guild audit logs for moderation and security triage",
      "commands": [
        {"name": "list", "description": "List recent guild audit log entries", "args": [], "options": [{"name": "--limit", "type": "int", "default": 50}, {"name": "--action"}, {"name": "--user", "type": "int"}, {"name": "--before", "type": "int"}, {"name": "--after", "type": "int"}]},
        {"name": "user", "description": "List audit entries performed by or targeting a user", "args": [{"name": "user_id", "type": "int", "required": true}], "options": [{"name": "--limit", "type": "int", "default": 50}]}
      ]
    },
    {
      "name": "doctor",
      "description": "Diagnose bot token, privileged intents, role hierarchy, and permissions",
      "commands": [
        {"name": "check", "description": "Run connectivity, intent, hierarchy, and permission diagnostics", "args": [], "options": [{"name": "--channel", "type": "int"}]}
      ]
    },
    {
      "name": "api",
      "description": "Call any Discord REST API v10 endpoint directly",
      "commands": [
        {"name": "request", "description": "Execute a raw authenticated Discord REST API v10 request", "args": [{"name": "method", "required": true}, {"name": "endpoint", "required": true}], "options": [{"name": "--json-body"}, {"name": "--query"}, {"name": "--reason"}]}
      ]
    }
  ]
}
